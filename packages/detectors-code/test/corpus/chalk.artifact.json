{"schemaVersion":2,"root":"<chalk>","scannedAt":"2026-08-24","include":["source/**/*.js","*.js"],"skipped":[],"files":[{"path":"benchmark.js","ext":".js","bytes":1493,"lines":58,"codeLines":41,"commentLines":3,"blankLines":14,"imports":["./source/index.js"],"role":"ordinary"},{"path":"source/index.js","ext":".js","bytes":8183,"lines":262,"codeLines":191,"commentLines":24,"blankLines":47,"imports":["./utilities.js","#ansi-styles","#supports-color","./vendor/ansi-styles/index.js"],"role":"ordinary"},{"path":"source/utilities.js","ext":".js","bytes":1187,"lines":34,"codeLines":28,"commentLines":1,"blankLines":5,"imports":[],"role":"ordinary"}],"functions":[{"file":"source/index.js","name":"applyOptions","startLine":35,"lineCount":18},{"file":"source/index.js","name":"chalk","startLine":53,"lineCount":8},{"file":"source/index.js","name":"createChalk","startLine":61,"lineCount":26},{"file":"source/index.js","name":"createModelConverters","startLine":87,"lineCount":4},{"file":"source/index.js","name":"ansi","startLine":91,"lineCount":1},{"file":"source/index.js","name":"ansi256","startLine":92,"lineCount":60},{"file":"source/index.js","name":"createStyler","startLine":152,"lineCount":20},{"file":"source/index.js","name":"createBuilder","startLine":172,"lineCount":2},{"file":"source/index.js","name":"builder","startLine":174,"lineCount":25},{"file":"source/index.js","name":"applyStyle","startLine":199,"lineCount":64},{"file":"source/utilities.js","name":"stringReplaceAll","startLine":2,"lineCount":19},{"file":"source/utilities.js","name":"stringEncaseCRLFWithFirstIndex","startLine":21,"lineCount":14}],"comments":[{"file":"benchmark.js","line":1,"text":"globals suite, bench","restatesNextLine":false,"givesRationale":false},{"file":"benchmark.js","line":49,"text":"eslint-disable-next-line no-unused-expressions","restatesNextLine":false,"givesRationale":false},{"file":"benchmark.js","line":54,"text":"eslint-disable-next-line no-unused-expressions","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":23,"text":"The level is stored under a symbol so the hot path can read it as a plain property, while `level` itself is an accessor that rejects values the rest of the code could not handle.","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":40,"text":"Detect level if not set manually. Written under the symbol rather than through `level`, as the prototype carrying that accessor is not installed until after this runs.","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":47,"text":"eslint-disable-next-line no-constructor-return","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":65,"text":"eslint-disable-next-line unicorn/no-top-level-side-effects -- The prototype chain must be set up at module load.","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":86,"text":"Resolve a color model to one converter per `level`, so that a call only has to look up the converter for the current level instead of re-deciding the model and level every time.","restatesNextLine":false,"givesRationale":true},{"file":"source/index.js","line":102,"text":"`ansi256` is already the native form, so only the 16-color levels need converting.","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":122,"text":"The level is read on call rather than captured here so the function can be cached on the instance instead of being reallocated on every property access.","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":123,"text":"`rgb` is the widest model, so naming the three parameters avoids a rest array.","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":173,"text":"Single argument is hot path, implicit coercion is faster than anything","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":176,"text":"eslint-disable-next-line no-implicit-coercion","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":187,"text":"We alter the prototype because we must return a function, but there is","restatesNextLine":false,"givesRationale":true},{"file":"source/index.js","line":188,"text":"no way to create a function with a different prototype","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":191,"text":"Point every builder at the root generator instead of its immediate parent, so reading the level costs one property load rather than walking a `level` getter per link of the chain.","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":200,"text":"Read the level directly off the generator to skip the `level` getter dispatch on this hot path","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":202,"text":"eslint-disable-next-line unicorn/no-computed-property-existence-check -- Reads the boolean value, not a property existence check.","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":215,"text":"Replace any instances already present with a re-opening code","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":216,"text":"otherwise only the part of the string until said closing code","restatesNextLine":false,"givesRationale":true},{"file":"source/index.js","line":217,"text":"will be colored, and the rest will simply be 'plain'.","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":224,"text":"We can move both next actions out of loop, because remaining actions in loop won't have","restatesNextLine":false,"givesRationale":true},{"file":"source/index.js","line":225,"text":"any/visible effect on parts we add here. Close the styling before a linebreak and reopen","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":226,"text":"after next line to fix a bleed issue on macOS: https://github.com/chalk/chalk/pull/92","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":235,"text":"`level` lives on the prototype rather than on each instance, so it costs nothing to construct an instance and matches how builders already expose it. It is inherited rather than own, so it does not show up in `Object.keys()`, same as for a ","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":236,"text":"eslint-disable-next-line unicorn/no-top-level-side-effects -- The style getters must be installed at module load.","restatesNextLine":false,"givesRationale":false},{"file":"source/index.js","line":249,"text":"TODO: Remove these aliases in the next major version","restatesNextLine":false,"givesRationale":false},{"file":"source/utilities.js","line":1,"text":"Note: Each match is kept and `postfix` is inserted after it. `String#replaceAll(substring, substring + postfix)` does the same, but it has to scan the replacement for `$` patterns and it is several times slower on the no-match path that mos","restatesNextLine":false,"givesRationale":false}],"placeholders":[],"duplicates":[],"agentFiles":[],"dependencies":[{"name":"@types/node","kind":"devDependencies","importedBy":[]},{"name":"ansi-styles","kind":"devDependencies","importedBy":[]},{"name":"ava","kind":"devDependencies","importedBy":[]},{"name":"c8","kind":"devDependencies","importedBy":[]},{"name":"color-convert","kind":"devDependencies","importedBy":[]},{"name":"execa","kind":"devDependencies","importedBy":[]},{"name":"log-update","kind":"devDependencies","importedBy":[]},{"name":"matcha","kind":"devDependencies","importedBy":[]},{"name":"typescript","kind":"devDependencies","importedBy":[]},{"name":"xo","kind":"devDependencies","importedBy":[]},{"name":"yoctodelay","kind":"devDependencies","importedBy":[]}],"configs":[{"path":".editorconfig","bytes":175,"matchesScaffoldDefault":null,"excerpt":"root = true [*] indent_style = tab end_of_line = lf 