# Every variable this repository reads, and what breaks without it.
#
# Copy to `.env.local` and fill in what you need. NOTHING here is required: with an empty file the
# whole test suite is green, the gauntlet runs against an in-memory database, and the notary stamps
# against a mock transport that emits real DER. That is deliberate, and it is the same rule
# `packages/reproduce` follows for model providers - a suite that needs credentials is a suite that
# only runs on the days somebody has them.
#
# No secret is committed to this repository and none ever should be.

# ---------------------------------------------------------------------------------------------
# Supabase (@slop/db). Unset means the in-memory database.
# ---------------------------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SLOP_SUPABASE_URL=

# SERVICE ROLE key. Server side only, never in a browser bundle.
#
# Why the service role and not the anon key: the gauntlet's answer key
# (`gauntlet_artifacts.label`, `gauntlet_rounds.human_index`) is column-revoked from every client
# role, and grading has to read it. If a request path could run with the anon key, the answer would
# have to be grantable, and the game would be over.
SLOP_SUPABASE_SERVICE_ROLE_KEY=

# Defaults to `public`. Present so a shared project can namespace these tables.
SLOP_SUPABASE_SCHEMA=

# ---------------------------------------------------------------------------------------------
# The gauntlet (@slop/gauntlet)
# ---------------------------------------------------------------------------------------------

# HMAC key for serve tickets. Any long random string; rotate freely, in-flight rounds just re-serve.
#
# Unset is a SUPPORTED state, not a broken one: no ticket is issued, every guess is stored with
# `timing_disputed = true`, and no published timing figure is computed from those rows. Correctness
# data is unaffected. An unsigned ticket would be worse than none, because it would look measured.
SLOP_GAUNTLET_TICKET_SECRET=

# Optional extra entropy in the round seed. Absent is fine at the current pool size: the seed only
# determines WHICH artifacts appear, and the player can see those anyway.
SLOP_GAUNTLET_SALT=

# ---------------------------------------------------------------------------------------------
# The notary (@slop/notary). No credential exists for any of this - RFC 3161 has no notion of an
# authenticated requester, and every default authority is free and unauthenticated.
# ---------------------------------------------------------------------------------------------

# Comma-separated RFC 3161 authority URLs, overriding the built-in fan-out. The defaults are
# timestamp.sigstore.dev, tsa.belgium.be/connect (free, EU-qualified, government-operated),
# freetsa.org and zeitstempel.dfn.de: four operators, three jurisdictions, zero cost.
SLOP_TSA_URLS=

# Per-authority deadline in milliseconds. Defaults to 8000. One slow authority must not hold up a
# stamp that three others already granted.
SLOP_TSA_TIMEOUT_MS=

# Comma-separated OpenTimestamps calendars. Optional ADDITIONAL anchor; a failure is never fatal and
# the commitment is pending for hours, so no credential ever speaks about it as an anchor.
SLOP_OPENTIMESTAMPS_CALENDARS=
